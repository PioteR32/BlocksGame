<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlocksGame.GamePage"
             xmlns:local="clr-namespace:BlocksGame.Views"
             xmlns:global="clr-namespace:BlocksGame"
             xmlns:utils="clr-namespace:BlocksGame.UtilsMaui.UtilsMaui.Utils"
             Title="GamePage" x:Name="Page"
             
            >
    <!--<ContentPage.BindingContext>
        <local:GamePageView/>
    </ContentPage.BindingContext>-->

    <VerticalStackLayout x:Name="MainAbsoluteLayout">
        <Grid RowDefinitions="*" ColumnDefinitions="*,*" MaximumWidthRequest="5000">
            <HorizontalStackLayout  BackgroundColor="Transparent" HorizontalOptions="Start">
                <Label  
                    Text="{Binding Combo, StringFormat='Combo : {0}'}" 
                    HorizontalOptions="Fill" />
                <Label 
                    Text="{Binding ChangeCombo, StringFormat=' {0}'}" 
                    HorizontalOptions="Fill" 
                    Opacity="{Binding ChangeComboOpacity}"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout  Grid.Column="1" 
                                    HorizontalOptions="End" 
                                    VerticalOptions="Start">
                <Label 
                    HorizontalOptions="End" 
                    Text="{Binding LivesStr}" 
                    Padding="2"/>
                <Label x:Name="minusLives" 
                       HorizontalOptions="End" 
                       Text=" -1" 
                       Padding="2" 
                       Opacity="0" 
                       TextColor="Red"/>
            </HorizontalStackLayout>
        </Grid>

        <HorizontalStackLayout HorizontalOptions="Center">
            <Label Text="{Binding ScoreStr}"  
                   FontSize="Header" />
            <Label x:Name="newScoreLabel"  
                   Text="{Binding NewScoreStr}"             
                   FontSize="Header"              
                   HorizontalOptions="Center"             
                   HorizontalTextAlignment="Center"             
                   TextColor="Red"
                   Opacity="0"
             >

            </Label>
        </HorizontalStackLayout>

        <VerticalStackLayout>
            <Button x:Name="loseButton" 
                    Clicked="LoseButtonClicked" 
                    Text="Lose" IsVisible="False"/>
        </VerticalStackLayout>

        <Grid utils:GridHelpers.ColumnCount="{Binding BlocksBoard.Width}"       
              utils:GridHelpers.RowCount="{Binding BlocksBoard.Height}"        
              BackgroundColor="Transparent"      
              HorizontalOptions="Center"
              x:Name="boardGrid"
              BindableLayout.ItemsSource="{Binding BlocksBoard.Fields}"
             >

            <BindableLayout.ItemTemplate >
                <DataTemplate x:DataType="global:Field" >
                    <Border Grid.Row="{Binding RowPosition}" Grid.Column="{Binding ColumnPosition}" 
                      BackgroundColor="Transparent">
                        <Label WidthRequest="{Binding Width}" 
                               HeightRequest="{Binding Height}" 
                               BackgroundColor="{Binding BackgroundColor}"/>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>

        </Grid>
        <!--<Grid x:Name="blocksView"/>-->
        <Grid utils:GridHelpers.ColumnCount="{Binding ColumnCount}"
              utils:GridHelpers.RowCount="{Binding RowCount}"
              BackgroundColor="Transparent"
              HorizontalOptions="Center"
              ColumnSpacing="20"
              Padding="20"
              BindableLayout.ItemsSource="{Binding ToChoose}"
              RowSpacing="10"
              x:Name="blocksView"
                      >
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="global:Block">
                    <Grid 
                        utils:GridHelpers.ColumnCount="{Binding Width}"
                        utils:GridHelpers.RowCount="{Binding Height}"
                        BackgroundColor="Transparent"
                        IsVisible="True"
                        HorizontalOptions="Center"
                        Grid.Column="{Binding ColumnPosition}"
                        Grid.Row="{Binding RowPosition}"
                        BindableLayout.ItemsSource="{Binding Fields}"

                      >
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="PanGetsureFnc" />
                        </Grid.GestureRecognizers>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="global:Field">
                                <Border Grid.Column="{Binding ColumnPosition}"
                                      Grid.Row="{Binding RowPosition}"
                                      WidthRequest="{Binding Width}"
                                      HeightRequest="{Binding Height}"
                                      VerticalOptions="CenterAndExpand">
                                    <Label 
                                        WidthRequest="{Binding Width}" 
                                        HeightRequest="{Binding Height}" 
                                        Background="{Binding BackgroundColor}"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </Grid>
    </VerticalStackLayout>
</ContentPage>