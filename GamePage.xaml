<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlocksGame.GamePage"
             xmlns:local="clr-namespace:BlocksGame"
             Title="GamePage" x:Name="Page">

    <AbsoluteLayout x:Name="MainAbsoluteLayout">
        <VerticalStackLayout x:Name="VerticalStackLayout">
            <Grid x:Name="board" HorizontalOptions="Center"/>
            <Grid x:Name="blocks" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </AbsoluteLayout>
</ContentPage>