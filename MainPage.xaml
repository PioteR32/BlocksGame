<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BlocksGame.Views"
             x:Class="BlocksGame.MainPage" x:Name="Page">
    <ContentPage.BindingContext>
        <local:MainPageView/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Picker">
                <Setter Property="FontSize" Value="Small" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>

        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="{Binding TheBestScoreStr}" FontSize="Header"/>
            <Button Command="{Binding Start}" Text="Start" />
            <Picker ItemsSource="{Binding GameModesStr}" SelectedIndex="{Binding GameModeInt}" HorizontalOptions="Center" Title="Game Mode"/>
            <HorizontalStackLayout Padding="10" HorizontalOptions="Center">
                <Picker SelectedItem="{Binding Width}" ItemsSource="{Binding PickerOptions}"   HorizontalOptions="Center" Title="Board Width"/>
                <Picker SelectedItem="{Binding Height}" ItemsSource="{Binding PickerOptions}" HorizontalOptions="Center"  Title="Board Height"/>
                <Picker SelectedItem="{Binding NumberOfBlocksToChoose}" ItemsSource="{Binding PickerOptions}"  HorizontalOptions="Center" Title="Blocks to choose"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
